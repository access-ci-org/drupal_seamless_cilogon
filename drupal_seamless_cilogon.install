<?php

/**
 * @file
 * Drupal Seamless CILogon installation and update hooks.
 */

/**
 * Set state.
 */
function drupal_seamless_cilogon_install(): void {
  \Drupal::state()->set('drupal_seamless_cilogon.logging', 0);
}

/**
 * Set state.
 */
function drupal_seamless_cilogon_update_9000(): void {
  \Drupal::state()->set('drupal_seamless_cilogon.logging', 0);
}
