<?php

/**
 * @file
 * Drupal Seamless CILogon installation and update hooks.
 */

/**
 * Set state.
 */
function drupal_seamless_cilogon_update_9000(): void {
  \Drupal::state()->set('drupal_seamless_cilogon.logging', 0);
}

/**
 * Delete the middleware logging setting; the middleware was removed.
 */
function drupal_seamless_cilogon_update_9001(): void {
  \Drupal::state()->delete('drupal_seamless_cilogon.logging');
}
